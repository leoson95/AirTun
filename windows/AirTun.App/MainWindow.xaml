<Window
    x:Class="AirTun.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="Root" Background="{StaticResource WindowSolidBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
            <RowDefinition Height="64" />
        </Grid.RowDefinitions>

        <!-- Custom Seamless Dark TitleBar -->
        <Grid Grid.Row="0" x:Name="AppTitleBar" Background="Transparent" Padding="14,0,14,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Brand Logo & Title -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Image Source="Assets/TitleBarLogo.png" Width="20" Height="20" VerticalAlignment="Center" />
                <TextBlock Text="AirTun" FontSize="16" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                <Border Background="{StaticResource FillTertiary}" CornerRadius="6" Padding="5,2" Margin="3,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="v1.0" FontSize="11" Foreground="{StaticResource LabelSecondary}" />
                </Border>
            </StackPanel>

            <!-- Language Toggle (Locked to Dark Theme) -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,135,0">
                <Button x:Name="BtnLangToggle" Content="FA" Padding="10,3" Height="30" MinHeight="30" FontSize="12.5" Style="{StaticResource SecondaryButton}" Click="BtnLangToggle_Click" ToolTipService.ToolTip="Toggle Language (FA / EN)" />
            </StackPanel>
        </Grid>

        <!-- TAB CONTENT CONTAINER -->
        <Grid Grid.Row="1" Padding="18,10,18,10">

            <!-- TAB 1: CONNECT -->
            <ScrollViewer x:Name="ViewTabConnect" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Visible">
                <StackPanel Spacing="16">

                    <!-- Status Hero Banner -->
                    <Border Background="{StaticResource FillSecondary}" CornerRadius="16" Padding="18,14" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Ellipse x:Name="StatusDot" Width="12" Height="12" Fill="{StaticResource AccentBrush}" Margin="0,0,14,0" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" x:Name="TextStatus" Text="Ready to Connect" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource LabelPrimary}" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- IDLE & DISCOVERY STATE -->
                    <StackPanel x:Name="PanelIdle" Spacing="16">

                        <!-- Mode Selector Segmented Cards -->
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- TUN Mode Card -->
                            <Border Grid.Column="0" x:Name="CardModeTun" CornerRadius="16" Padding="16,16" Background="{StaticResource FillTertiary}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="2" PointerPressed="CardModeTun_PointerPressed" ToolTipService.ToolTip="Routes 100% of Windows traffic through virtual network adapter (Gaming, Telegram, Git, Docker, Browsers)">
                                <StackPanel Spacing="6" HorizontalAlignment="Center">
                                    <TextBlock Text="⚡ TUN Mode" FontSize="17" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" />
                                    <TextBlock x:Name="TextTunSub" Text="Games &amp; All Apps" FontSize="13.5" Foreground="{StaticResource LabelSecondary}" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <!-- Proxy Mode Card -->
                            <Border Grid.Column="1" x:Name="CardModeProxy" CornerRadius="16" Padding="16,16" Background="{StaticResource FillSecondary}" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1" PointerPressed="CardModeProxy_PointerPressed" ToolTipService.ToolTip="Configures Windows system proxy for browsers and standard HTTP/HTTPS web apps">
                                <StackPanel Spacing="6" HorizontalAlignment="Center">
                                    <TextBlock Text="🌐 Web Proxy" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource LabelPrimary}" HorizontalAlignment="Center" />
                                    <TextBlock x:Name="TextProxySub" Text="Browsers &amp; Web" FontSize="13.5" Foreground="{StaticResource LabelSecondary}" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Auto-Discovered Phone Card - Premium Style -->
                        <Border Background="{StaticResource FillSecondary}" CornerRadius="20" Padding="0" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1">
                            <Grid>
                                <!-- Subtle top accent line -->
                                <Border Height="2" VerticalAlignment="Top" Background="{StaticResource AccentBrush}" />
                                <StackPanel Spacing="0" Margin="0,2,0,0">
                                    <!-- Header row -->
                                    <Grid Padding="18,14,18,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <!-- Phone icon circle -->
                                        <Border Grid.Column="0" Width="44" Height="44" CornerRadius="12" Background="{StaticResource FillTertiary}" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1" Margin="0,0,12,0">
                                            <TextBlock Text="📱" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock x:Name="TextDetectedPhoneName" Text="در حال جستجو..." FontSize="16" FontWeight="Bold" Foreground="{StaticResource LabelPrimary}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock x:Name="TextDetectedPhoneIp" Text="هات‌اسپات را روشن کنید و در اپ START بزنید" FontSize="12" Foreground="{StaticResource LabelSecondary}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Border Grid.Column="2" x:Name="BadgeSignal" Background="{StaticResource FillTertiary}" CornerRadius="10" Padding="10,5" VerticalAlignment="Center">
                                            <TextBlock x:Name="TextSignalStatus" Text="📡 Scanning" FontSize="12" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" />
                                        </Border>
                                    </Grid>

                                    <!-- Divider -->
                                    <Border Height="1" Background="{StaticResource HairlineBrush}" Margin="18,0" />

                                    <!-- PIN section -->
                                    <StackPanel Padding="18,14,18,18" Spacing="10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="TextPinHint" Grid.Column="0" Text="پین ۴ رقمی امنیتی" FontSize="13" Foreground="{StaticResource LabelSecondary}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="خودکار شناسایی می‌شود ✓" FontSize="11" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                                        </Grid>
                                        <TextBox x:Name="InputPin" PlaceholderText="----" MaxLength="4" FontSize="28" FontWeight="Bold" TextAlignment="Center" Height="58" FontFamily="{StaticResource FontMono}" CornerRadius="12" BorderBrush="{StaticResource HairlineBrush}" />
                                        <Button x:Name="BtnConnect" Content="اتصال به گوشی" FontSize="16" FontWeight="Bold" Height="50" Style="{StaticResource PrimaryButton}" Click="BtnConnect_Click" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- CONNECTED ACTIVE STATE -->
                    <StackPanel x:Name="PanelConnected" Spacing="14" Visibility="Collapsed">
                        <Border Background="{StaticResource FillSecondary}" CornerRadius="20" Padding="20" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1.5">
                            <StackPanel Spacing="14">
                                <!-- Endpoint & Badge -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="3">
                                        <TextBlock x:Name="TextConnectedDevice" Text="Connected to Phone" FontSize="22" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                                        <TextBlock x:Name="TextConnectedEndpoint" Text="192.168.43.1:10808 (TUN Mode)" FontSize="13.5" FontFamily="{StaticResource FontMono}" Foreground="{StaticResource LabelSecondary}" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="{StaticResource FillTertiary}" CornerRadius="8" Padding="12,5" VerticalAlignment="Center">
                                        <TextBlock Text="● ACTIVE" FontSize="13" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                                    </Border>
                                </Grid>

                                <!-- Outbound IP & Location -->
                                <Border Background="{StaticResource FillSunken}" CornerRadius="14" Padding="14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="3">
                                            <TextBlock x:Name="TextGeoLocation" Text="🌐 Resolving location..." FontSize="16" FontWeight="Bold" Foreground="{StaticResource LabelPrimary}" />
                                            <TextBlock x:Name="TextGeoIsp" Text="Detecting public IP &amp; ISP..." FontSize="13.5" Foreground="{StaticResource LabelSecondary}" />
                                        </StackPanel>
                                        <Button Grid.Column="1" x:Name="BtnRefreshGeo" Content="🔄" Padding="10,4" Height="36" MinHeight="36" FontSize="15" Style="{StaticResource QuietButton}" Click="BtnRefreshGeo_Click" ToolTipService.ToolTip="Refresh Location &amp; IP" />
                                    </Grid>
                                </Border>

                                <!-- LIVE TRAFFIC WAVEFORM / GRAPH -->
                                <Border Background="{StaticResource FillSunken}" CornerRadius="16" Padding="16,12">
                                    <StackPanel Spacing="8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <TextBlock x:Name="TextLiveTrafficHeader" Text="Live Network Waveform" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource LabelPrimary}" VerticalAlignment="Center" />
                                                <Border Background="{StaticResource FillTertiary}" CornerRadius="6" Padding="6,2" VerticalAlignment="Center">
                                                    <TextBlock x:Name="TextPeakSpeed" Text="Peak: 0 KB/s" FontSize="11.5" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" />
                                                </Border>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <Ellipse Width="8" Height="8" Fill="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                                                    <TextBlock Text="Down" FontSize="12" Foreground="{StaticResource LabelSecondary}" />
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <Ellipse Width="8" Height="8" Fill="#FF38BDF8" VerticalAlignment="Center" />
                                                    <TextBlock Text="Up" FontSize="12" Foreground="{StaticResource LabelSecondary}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Canvas Graph Container -->
                                        <Border Height="80" Background="{StaticResource FillSecondary}" CornerRadius="10" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1">
                                            <Canvas x:Name="CanvasTrafficGraph" Height="80" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- Live Speed Gauges -->
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Background="{StaticResource FillSunken}" CornerRadius="14" Padding="14">
                                        <StackPanel HorizontalAlignment="Center" Spacing="3">
                                            <TextBlock Text="↓ Download Rate" FontSize="13.5" Foreground="{StaticResource LabelSecondary}" />
                                            <TextBlock x:Name="TextDownSpeed" Text="0 KB/s" FontSize="24" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                                            <TextBlock x:Name="TextDownTotal" Text="Total: 0 MB" FontSize="13" Foreground="{StaticResource LabelSecondary}" />
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="1" Background="{StaticResource FillSunken}" CornerRadius="14" Padding="14">
                                        <StackPanel HorizontalAlignment="Center" Spacing="3">
                                            <TextBlock Text="↑ Upload Rate" FontSize="13.5" Foreground="{StaticResource LabelSecondary}" />
                                            <TextBlock x:Name="TextUpSpeed" Text="0 KB/s" FontSize="24" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                                            <TextBlock x:Name="TextUpTotal" Text="Total: 0 MB" FontSize="13" Foreground="{StaticResource LabelSecondary}" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Latency & Duration -->
                                <Grid Margin="0,2,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" x:Name="TextLatency" Text="Latency: 18 ms" FontSize="14" Foreground="{StaticResource LabelSecondary}" HorizontalAlignment="Left" />
                                    <TextBlock Grid.Column="1" x:Name="TextDuration" Text="Duration: 00:02:14" FontSize="14" Foreground="{StaticResource LabelSecondary}" HorizontalAlignment="Right" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Button x:Name="BtnDisconnect" Content="Disconnect" FontSize="16.5" Height="50" Background="{StaticResource DangerSoftBrush}" Foreground="{StaticResource DangerBrush}" BorderBrush="{StaticResource DangerBrush}" Style="{StaticResource ButtonBase}" Click="BtnDisconnect_Click" />
                    </StackPanel>

                    <!-- ERROR PANEL -->
                    <StackPanel x:Name="PanelError" Spacing="16" Visibility="Collapsed">
                        <Border Background="{StaticResource DangerSoftBrush}" CornerRadius="18" Padding="20" BorderBrush="{StaticResource DangerBrush}" BorderThickness="1">
                            <StackPanel Spacing="10" HorizontalAlignment="Center">
                                <TextBlock Text="⚠️" FontSize="40" HorizontalAlignment="Center" />
                                <TextBlock x:Name="TextErrorTitle" Text="Connection Error" FontSize="20" FontWeight="Bold" Foreground="{StaticResource DangerBrush}" />
                                <TextBlock x:Name="TextErrorBody" Text="Cannot reach the Android device." FontSize="15.5" Foreground="{StaticResource LabelPrimary}" TextWrapping="Wrap" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" x:Name="BtnErrorDismiss" Content="Dismiss" FontSize="16" Height="48" Style="{StaticResource SecondaryButton}" Click="BtnErrorDismiss_Click" />
                            <Button Grid.Column="1" x:Name="BtnErrorRetry" Content="Retry" FontSize="16" Height="48" Style="{StaticResource PrimaryButton}" Click="BtnErrorRetry_Click" />
                        </Grid>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>

            <!-- TAB 2: ROUTING -->
            <ScrollViewer x:Name="ViewTabRouting" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
                <StackPanel Spacing="18">
                    <TextBlock Text="Smart Routing &amp; Rules" FontSize="22" FontWeight="Bold" Foreground="{StaticResource LabelPrimary}" />

                    <!-- Iran Bypass Glass Card -->
                    <Border Background="{StaticResource FillSecondary}" CornerRadius="18" Padding="18" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="4">
                                <TextBlock x:Name="TextBypassTitle" Text="Bypass Iranian Sites (.ir)" FontSize="17" FontWeight="Bold" Foreground="{StaticResource LabelPrimary}" />
                                <TextBlock x:Name="TextBypassDesc" Text="Domestic domains and banks open directly without tunneling to save bandwidth." FontSize="13.5" Foreground="{StaticResource LabelSecondary}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" x:Name="SwitchBypassDomestic" IsOn="True" Toggled="SwitchBypassDomestic_Toggled" OnContent="" OffContent="" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- Custom Rules Section -->
                    <Border Background="{StaticResource FillSecondary}" CornerRadius="18" Padding="18" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1">
                        <StackPanel Spacing="14">
                            <TextBlock x:Name="TextCustomRulesHeader" Text="Custom Rules (Direct vs Proxy vs Block)" FontSize="16" FontWeight="Bold" Foreground="{StaticResource LabelPrimary}" />

                            <!-- Add Rule Form -->
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" x:Name="InputNewRulePattern" FontSize="14.5" PlaceholderText="Domain (e.g. digikala.com or *.ir)" Height="44" />
                                <ComboBox Grid.Column="1" x:Name="ComboNewRuleAction" SelectedIndex="0" MinWidth="105" FontSize="14.5" Height="44">
                                    <ComboBoxItem Content="Direct" />
                                    <ComboBoxItem Content="Proxy" />
                                    <ComboBoxItem Content="Block" />
                                </ComboBox>
                                <Button Grid.Column="2" x:Name="BtnAddRule" Content="+" Padding="18,4" FontSize="20" FontWeight="Bold" Style="{StaticResource PrimaryButton}" Height="44" Click="BtnAddRule_Click" />
                            </Grid>

                            <!-- Rules List -->
                            <ListView x:Name="ListCustomRules" SelectionMode="None" MaxHeight="300">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource FillTertiary}" CornerRadius="12" Padding="12,8" Margin="0,4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Pattern}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                <Border Grid.Column="1" Background="{StaticResource FillSunken}" CornerRadius="6" Padding="10,3" Margin="10,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Action}" FontSize="13" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" />
                                                </Border>
                                                <Button Grid.Column="2" Content="✕" Padding="10,2" Height="32" MinHeight="32" FontSize="14" Style="{StaticResource QuietButton}" Click="BtnDeleteRule_Click" Tag="{Binding}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- TAB 3: LOGS -->
            <Grid x:Name="ViewTabLogs" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="System Diagnostics &amp; Logs" FontSize="22" FontWeight="Bold" Foreground="{StaticResource LabelPrimary}" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <Button x:Name="BtnCopyLogs" Content="Copy Logs" Padding="14,4" Height="36" MinHeight="36" FontSize="13.5" Style="{StaticResource SecondaryButton}" Click="BtnCopyLogs_Click" />
                        <Button x:Name="BtnClearLogs" Content="Clear" Padding="14,4" Height="36" MinHeight="36" FontSize="13.5" Style="{StaticResource QuietButton}" Click="BtnClearLogs_Click" />
                    </StackPanel>
                </Grid>

                <TextBox Grid.Row="1" x:Name="TextLogsViewer" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="{StaticResource FontMono}" FontSize="13" Background="{StaticResource FillSecondary}" BorderBrush="{StaticResource HairlineBrush}" CornerRadius="16" Padding="14" />
            </Grid>

            <!-- TAB 4: SETTINGS & ABOUT -->
            <ScrollViewer x:Name="ViewTabAbout" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
                <StackPanel Spacing="16" HorizontalAlignment="Center" MaxWidth="520">

                    <!-- App & Tray Settings Card -->
                    <Border Background="{StaticResource FillSecondary}" CornerRadius="18" Padding="20" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1">
                        <StackPanel Spacing="14">
                            <TextBlock x:Name="TextSettingsHeader" Text="App Behavior &amp; System Tray" FontSize="16" FontWeight="Bold" Foreground="{StaticResource LabelPrimary}" />

                            <!-- Start with Windows Switch -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock x:Name="TextStartWithWindowsTitle" Text="Start with Windows (System Tray)" FontSize="14.5" FontWeight="SemiBold" Foreground="{StaticResource LabelPrimary}" />
                                    <TextBlock x:Name="TextStartWithWindowsDesc" Text="Launch automatically on Windows startup minimized to system tray." FontSize="12.5" Foreground="{StaticResource LabelSecondary}" TextWrapping="Wrap" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" x:Name="SwitchStartWithWindows" IsOn="False" Toggled="SwitchStartWithWindows_Toggled" OnContent="" OffContent="" VerticalAlignment="Center" />
                            </Grid>

                            <!-- Close to Tray Switch -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock x:Name="TextCloseToTrayTitle" Text="Minimize to Tray on Close (X)" FontSize="14.5" FontWeight="SemiBold" Foreground="{StaticResource LabelPrimary}" />
                                    <TextBlock x:Name="TextCloseToTrayDesc" Text="Keep connection active in background when window is closed." FontSize="12.5" Foreground="{StaticResource LabelSecondary}" TextWrapping="Wrap" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" x:Name="SwitchCloseToTray" IsOn="True" Toggled="SwitchCloseToTray_Toggled" OnContent="" OffContent="" VerticalAlignment="Center" />
                            </Grid>

                            <!-- Minimize to Tray Switch -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock x:Name="TextMinimizeToTrayTitle" Text="Minimize to Tray on Minimize (_)" FontSize="14.5" FontWeight="SemiBold" Foreground="{StaticResource LabelPrimary}" />
                                    <TextBlock x:Name="TextMinimizeToTrayDesc" Text="Hide window to system tray when minimized." FontSize="12.5" Foreground="{StaticResource LabelSecondary}" TextWrapping="Wrap" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" x:Name="SwitchMinimizeToTray" IsOn="False" Toggled="SwitchMinimizeToTray_Toggled" OnContent="" OffContent="" VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Branding & About Card -->
                    <Border Background="{StaticResource FillSecondary}" CornerRadius="18" Padding="20" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1">
                        <StackPanel Spacing="12">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Image Source="Assets/Square44x44Logo.png" Width="26" Height="26" VerticalAlignment="Center" />
                                <TextBlock Text="AirTun v1.0.0" FontSize="18" FontWeight="Bold" Foreground="{StaticResource LabelPrimary}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock x:Name="TextAboutDescription" Text="Modern, ultra-low latency internet sharing from Android to Windows with native SOCKS5 and WinTun virtual adapter." FontSize="14" Foreground="{StaticResource LabelSecondary}" TextWrapping="Wrap" />
                            <MenuFlyoutSeparator />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Developer" FontSize="14" Foreground="{StaticResource LabelSecondary}" />
                                <TextBlock Grid.Column="1" Text="Omid Zaferi" FontSize="14" FontWeight="Bold" Foreground="{StaticResource LabelPrimary}" />
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="License" FontSize="14" Foreground="{StaticResource LabelSecondary}" />
                                <TextBlock Grid.Column="1" Text="MIT Open Source" FontSize="14" Foreground="{StaticResource LabelPrimary}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Button x:Name="BtnOpenGithub" Content="⭐ Open Project on GitHub" FontSize="15" Height="46" Style="{StaticResource SecondaryButton}" Click="BtnOpenGithub_Click" />
                </StackPanel>
            </ScrollViewer>

        </Grid>

        <!-- BOTTOM NAVIGATION BAR (RTL order: Settings | Logs | Routing | Connect) -->
        <Border Grid.Row="2" Background="{StaticResource FillSecondary}" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,1,0,0">
            <Grid Padding="0,6,0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Col 0: Settings -->
                <Button Grid.Column="0" x:Name="NavBtnAbout" Background="Transparent" BorderThickness="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Click="NavBtnAbout_Click">
                    <Grid>
                        <Border Height="2" Background="Transparent" VerticalAlignment="Top" Margin="0,-6,0,0" HorizontalAlignment="Stretch" />
                        <StackPanel Spacing="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="⚙️" FontSize="17" HorizontalAlignment="Center" />
                            <TextBlock x:Name="NavTextAbout" Text="Settings" FontSize="12.5" Foreground="{StaticResource LabelSecondary}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Button>

                <!-- Col 1: Logs -->
                <Button Grid.Column="1" x:Name="NavBtnLogs" Background="Transparent" BorderThickness="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Click="NavBtnLogs_Click">
                    <Grid>
                        <Border Height="2" Background="Transparent" VerticalAlignment="Top" Margin="0,-6,0,0" HorizontalAlignment="Stretch" />
                        <StackPanel Spacing="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="📋" FontSize="17" HorizontalAlignment="Center" />
                            <TextBlock x:Name="NavTextLogs" Text="Logs" FontSize="12.5" Foreground="{StaticResource LabelSecondary}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Button>

                <!-- Col 2: Routing -->
                <Button Grid.Column="2" x:Name="NavBtnRouting" Background="Transparent" BorderThickness="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Click="NavBtnRouting_Click">
                    <Grid>
                        <Border Height="2" Background="Transparent" VerticalAlignment="Top" Margin="0,-6,0,0" HorizontalAlignment="Stretch" />
                        <StackPanel Spacing="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="🛡️" FontSize="17" HorizontalAlignment="Center" />
                            <TextBlock x:Name="NavTextRouting" Text="Routing" FontSize="12.5" Foreground="{StaticResource LabelSecondary}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Button>

                <!-- Col 3: Connect (Primary / Home) -->
                <Button Grid.Column="3" x:Name="NavBtnConnect" Background="Transparent" BorderThickness="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Click="NavBtnConnect_Click">
                    <Grid>
                        <Border Height="2" Background="{StaticResource AccentBrush}" VerticalAlignment="Top" Margin="0,-6,0,0" HorizontalAlignment="Stretch" />
                        <StackPanel Spacing="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="🚀" FontSize="17" HorizontalAlignment="Center" />
                            <TextBlock x:Name="NavTextConnect" Text="Connect" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Button>
            </Grid>
        </Border>


    </Grid>
</Window>
