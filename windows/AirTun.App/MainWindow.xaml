<Window
    x:Class="AirTun.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="Root" Background="{StaticResource WindowSolidBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom Seamless Dark TitleBar -->
        <Grid Grid.Row="0" x:Name="AppTitleBar" Background="Transparent" Padding="14,0,14,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Brand Logo & Title -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Ellipse Width="10" Height="10" Fill="{StaticResource AccentBrush}" />
                <TextBlock Text="AirTun" FontSize="15" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                <TextBlock x:Name="TextTitleTag" Text="v1.0" FontSize="12" Foreground="{StaticResource LabelSecondary}" VerticalAlignment="Center" />
            </StackPanel>

            <!-- Language & Theme Toggles -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,0,130,0">
                <Button x:Name="BtnLangToggle" Content="FA" Padding="8,2" Height="28" MinHeight="28" FontSize="12" Style="{StaticResource SecondaryButton}" Click="BtnLangToggle_Click" ToolTipService.ToolTip="Toggle Language (FA / EN)" />
                <Button x:Name="BtnThemeToggle" Content="🌙" Padding="8,2" Height="28" MinHeight="28" FontSize="12" Style="{StaticResource SecondaryButton}" Click="BtnThemeToggle_Click" ToolTipService.ToolTip="Toggle Theme (Dark / Light)" />
            </StackPanel>
        </Grid>

        <!-- Main Body -->
        <ScrollViewer Grid.Row="1" Padding="20,10,20,18" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="14">

                <!-- Status Banner -->
                <Border x:Name="StatusBanner" Background="{StaticResource FillSecondary}" CornerRadius="12" Padding="14,10" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="{StaticResource AccentBrush}" Margin="0,0,10,0" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" x:Name="TextStatus" Text="Ready to Connect" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource LabelPrimary}" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- IDLE / DISCOVERY PANEL -->
                <StackPanel x:Name="PanelIdle" Spacing="14">

                    <!-- Modern 2-Column Mode Selector Cards -->
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- TUN Mode Card -->
                        <Border Grid.Column="0" x:Name="CardModeTun" CornerRadius="12" Padding="12,10" Background="{StaticResource FillTertiary}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="2" PointerPressed="CardModeTun_PointerPressed" ToolTipService.ToolTip="Routes 100% of Windows traffic through virtual adapter (Gaming, Telegram, Git, Docker, Browsers)">
                            <StackPanel Spacing="3" HorizontalAlignment="Center">
                                <TextBlock Text="⚡ TUN Mode" FontSize="15" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" />
                                <TextBlock x:Name="TextTunSub" Text="Games &amp; All Apps" FontSize="12" Foreground="{StaticResource LabelSecondary}" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <!-- Proxy Mode Card -->
                        <Border Grid.Column="1" x:Name="CardModeProxy" CornerRadius="12" Padding="12,10" Background="{StaticResource FillSecondary}" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1" PointerPressed="CardModeProxy_PointerPressed" ToolTipService.ToolTip="Configures Windows system proxy for browsers and standard HTTP/HTTPS apps">
                            <StackPanel Spacing="3" HorizontalAlignment="Center">
                                <TextBlock Text="🌐 Web Proxy" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource LabelPrimary}" HorizontalAlignment="Center" />
                                <TextBlock x:Name="TextProxySub" Text="Browsers &amp; Web" FontSize="12" Foreground="{StaticResource LabelSecondary}" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Smart Routing Iran Bypass Glass Card with ToolTip -->
                    <Border Background="{StaticResource FillSecondary}" CornerRadius="14" Padding="14,10" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1" ToolTipService.ToolTip="Domestic (.ir) domains, bank gateways and government portals connect directly without tunneling for max speed and savings.">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock x:Name="TextBypassTitle" Text="Bypass Iranian Sites (.ir)" FontSize="14.5" FontWeight="SemiBold" Foreground="{StaticResource LabelPrimary}" />
                                    <TextBlock Text="ℹ️" FontSize="12" Foreground="{StaticResource LabelSecondary}" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock x:Name="TextBypassDesc" Text="Direct connection for national sites &amp; banks" FontSize="12" Foreground="{StaticResource LabelSecondary}" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" x:Name="SwitchBypassDomestic" IsOn="True" Toggled="SwitchBypassDomestic_Toggled" OnContent="" OffContent="" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- Discovered Devices List -->
                    <Border Background="{StaticResource FillSecondary}" CornerRadius="14" Padding="14,12" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1">
                        <StackPanel Spacing="10">
                            <TextBlock x:Name="TextDiscoveredHeader" Text="Discovered Devices" FontSize="14.5" FontWeight="Bold" Foreground="{StaticResource LabelPrimary}" />
                            <ListView x:Name="ListDevices" SelectionMode="Single" SelectionChanged="ListDevices_SelectionChanged" MaxHeight="130">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource FillTertiary}" CornerRadius="10" Padding="10,8" Margin="0,3">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Spacing="1">
                                                    <TextBlock Text="{Binding DeviceName}" FontSize="14.5" FontWeight="Bold" Foreground="{StaticResource LabelPrimary}" />
                                                    <TextBlock Text="{Binding Host}" FontSize="12" Foreground="{StaticResource AccentBrush}" FontFamily="{StaticResource FontMono}" />
                                                </StackPanel>
                                                <Button Grid.Column="1" Content="Connect ▶" Padding="10,4" FontSize="13" FontWeight="Bold" Style="{StaticResource PrimaryButton}" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <TextBlock x:Name="TextNoDevices" Text="Searching Wi-Fi / Hotspot / USB for AirTun..." FontSize="13" Foreground="{StaticResource LabelSecondary}" HorizontalAlignment="Center" Visibility="Visible" />
                        </StackPanel>
                    </Border>

                    <!-- Manual Host & PIN Input Card -->
                    <Border Background="{StaticResource FillSecondary}" CornerRadius="14" Padding="14,12" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1">
                        <StackPanel Spacing="10">
                            <TextBlock x:Name="TextManualHeader" Text="Manual IP Connection" FontSize="14.5" FontWeight="Bold" Foreground="{StaticResource LabelPrimary}" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" x:Name="InputHost" Header="Server IP" FontSize="14" PlaceholderText="192.168.43.1" />
                                <TextBox Grid.Column="1" x:Name="InputPin" Header="4-Digit PIN" FontSize="14" PlaceholderText="1234" MaxLength="4" />
                            </Grid>
                            <Button x:Name="BtnConnect" Content="Connect to Phone" FontSize="15" Style="{StaticResource PrimaryButton}" Margin="0,4,0,0" Click="BtnConnect_Click" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- CONNECTED DASHBOARD -->
                <StackPanel x:Name="PanelConnected" Spacing="14" Visibility="Collapsed">
                    <Border Background="{StaticResource FillSecondary}" CornerRadius="16" Padding="16" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1.5">
                        <StackPanel Spacing="12">
                            <!-- Device info & Mode -->
                            <TextBlock x:Name="TextConnectedDevice" Text="Connected to Phone" FontSize="20" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                            <TextBlock x:Name="TextConnectedEndpoint" Text="192.168.43.1:10808 (Full TUN Mode)" FontSize="13" FontFamily="{StaticResource FontMono}" Foreground="{StaticResource LabelSecondary}" />

                            <!-- Outbound IP & Geo Location Card -->
                            <Border Background="{StaticResource FillSunken}" CornerRadius="12" Padding="12" Margin="0,2,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="3">
                                        <TextBlock x:Name="TextGeoLocation" Text="🌐 Resolving location..." FontSize="15" FontWeight="Bold" Foreground="{StaticResource LabelPrimary}" />
                                        <TextBlock x:Name="TextGeoIsp" Text="Detecting public IP &amp; ISP..." FontSize="13" Foreground="{StaticResource LabelSecondary}" />
                                    </StackPanel>
                                    <Button Grid.Column="1" x:Name="BtnRefreshGeo" Content="🔄" Padding="8,4" Height="32" MinHeight="32" FontSize="14" Style="{StaticResource QuietButton}" Click="BtnRefreshGeo_Click" ToolTipService.ToolTip="Refresh Location &amp; IP" />
                                </Grid>
                            </Border>

                            <!-- Live Speed & Data Gauges -->
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Background="{StaticResource FillSunken}" CornerRadius="12" Padding="12" Margin="0,0,5,0">
                                    <StackPanel HorizontalAlignment="Center" Spacing="2">
                                        <TextBlock Text="↓ Download" FontSize="13" Foreground="{StaticResource LabelSecondary}" />
                                        <TextBlock x:Name="TextDownSpeed" Text="0 KB/s" FontSize="20" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                                        <TextBlock x:Name="TextDownTotal" Text="0 MB" FontSize="12.5" Foreground="{StaticResource LabelSecondary}" />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="1" Background="{StaticResource FillSunken}" CornerRadius="12" Padding="12" Margin="5,0,0,0">
                                    <StackPanel HorizontalAlignment="Center" Spacing="2">
                                        <TextBlock Text="↑ Upload" FontSize="13" Foreground="{StaticResource LabelSecondary}" />
                                        <TextBlock x:Name="TextUpSpeed" Text="0 KB/s" FontSize="20" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                                        <TextBlock x:Name="TextUpTotal" Text="0 MB" FontSize="12.5" Foreground="{StaticResource LabelSecondary}" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Grid Margin="0,2,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" x:Name="TextLatency" Text="Ping: 18 ms" FontSize="13.5" Foreground="{StaticResource LabelSecondary}" HorizontalAlignment="Left" />
                                <TextBlock Grid.Column="1" x:Name="TextDuration" Text="Duration: 00:02:14" FontSize="13.5" Foreground="{StaticResource LabelSecondary}" HorizontalAlignment="Right" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Button x:Name="BtnDisconnect" Content="Disconnect" FontSize="15" Background="{StaticResource DangerSoftBrush}" Foreground="{StaticResource DangerBrush}" BorderBrush="{StaticResource DangerBrush}" Style="{StaticResource ButtonBase}" Click="BtnDisconnect_Click" />
                </StackPanel>

                <!-- ERROR PANEL -->
                <StackPanel x:Name="PanelError" Spacing="12" Visibility="Collapsed">
                    <Border Background="{StaticResource DangerSoftBrush}" CornerRadius="14" Padding="16" BorderBrush="{StaticResource DangerBrush}" BorderThickness="1">
                        <StackPanel Spacing="6" HorizontalAlignment="Center">
                            <TextBlock Text="⚠️" FontSize="32" HorizontalAlignment="Center" />
                            <TextBlock x:Name="TextErrorTitle" Text="Connection Error" FontSize="18" FontWeight="Bold" Foreground="{StaticResource DangerBrush}" />
                            <TextBlock x:Name="TextErrorBody" Text="Cannot reach the Android device." FontSize="14.5" Foreground="{StaticResource LabelPrimary}" TextWrapping="Wrap" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" x:Name="BtnErrorDismiss" Content="Dismiss" FontSize="14.5" Style="{StaticResource SecondaryButton}" Click="BtnErrorDismiss_Click" />
                        <Button Grid.Column="1" x:Name="BtnErrorRetry" Content="Retry" FontSize="14.5" Style="{StaticResource PrimaryButton}" Click="BtnErrorRetry_Click" />
                    </Grid>
                </StackPanel>

                <!-- CUSTOM ROUTING RULES MANAGER EXPANDER -->
                <Expander x:Name="ExpanderRouting" Header="Smart Routing &amp; Rules" Margin="0,2,0,0" HorizontalAlignment="Stretch" CornerRadius="12">
                    <StackPanel Spacing="10" Padding="4">
                        <TextBlock x:Name="TextCustomRulesIntro" Text="Custom Rules (Direct vs Proxy vs Block)" FontSize="13" Foreground="{StaticResource LabelSecondary}" />

                        <!-- Add Rule Row -->
                        <Grid ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" x:Name="InputNewRulePattern" FontSize="13.5" PlaceholderText="Domain (e.g. digikala.com)" />
                            <ComboBox Grid.Column="1" x:Name="ComboNewRuleAction" SelectedIndex="0" MinWidth="85" FontSize="13">
                                <ComboBoxItem Content="Direct" />
                                <ComboBoxItem Content="Proxy" />
                                <ComboBoxItem Content="Block" />
                            </ComboBox>
                            <Button Grid.Column="2" x:Name="BtnAddRule" Content="+" Padding="12,4" FontSize="16" FontWeight="Bold" Style="{StaticResource PrimaryButton}" Click="BtnAddRule_Click" />
                        </Grid>

                        <!-- Custom Rules List -->
                        <ListView x:Name="ListCustomRules" SelectionMode="None" MaxHeight="130">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="4,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Pattern}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <Border Grid.Column="1" Background="{StaticResource FillTertiary}" CornerRadius="6" Padding="8,2" Margin="6,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Action}" FontSize="12.5" Foreground="{StaticResource AccentBrush}" />
                                        </Border>
                                        <Button Grid.Column="2" Content="✕" Padding="8,2" Height="28" MinHeight="28" FontSize="12" Style="{StaticResource QuietButton}" Click="BtnDeleteRule_Click" Tag="{Binding}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Expander>

                <!-- Advanced & Diagnostic Logs -->
                <Expander x:Name="ExpanderLogs" Header="Advanced &amp; Logs" Margin="0,2,0,0" HorizontalAlignment="Stretch" CornerRadius="12">
                    <StackPanel Spacing="8" Padding="4">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                            <Button x:Name="BtnCopyLogs" Content="Copy Logs" Padding="10,3" Height="30" MinHeight="30" FontSize="12.5" Style="{StaticResource QuietButton}" Click="BtnCopyLogs_Click" />
                            <Button x:Name="BtnClearLogs" Content="Clear" Padding="10,3" Height="30" MinHeight="30" FontSize="12.5" Style="{StaticResource QuietButton}" Click="BtnClearLogs_Click" />
                        </StackPanel>
                        <TextBox x:Name="TextLogsViewer" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="100" FontFamily="{StaticResource FontMono}" FontSize="12" />
                    </StackPanel>
                </Expander>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
